{
  "name": "chat-x-ray",
  "version": "1.0.3",
  "private": true,
  "description": "Local-only Twitch chat analysis: bot scoring, client-side R9K, audit log and a live-viewer estimate. Chrome/Edge/Opera and Firefox, RU/EN.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.js",
    "build:all": "node build.js --all",
    "build:firefox": "node build.js --firefox-only",
    "dev": "node build.js --watch",
    "package": "node build.js --package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build:all && npm run test:e2e",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "verify": "npm run typecheck && npm run test && npm run build:all && npm run lint:firefox && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json"
  },
  "keywords": [
    "twitch",
    "chat",
    "bot-detection",
    "r9k",
    "manifest-v3",
    "webextension",
    "chrome-extension",
    "firefox-addon"
  ],
  "author": "Chat X-Ray contributors",
  "dependencies": {
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.8",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "web-ext": "^10.8.0"
  }
}
