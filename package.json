{
  "name": "chat-x-ray",
  "version": "1.0.0",
  "private": true,
  "description": "Local-only Twitch chat analysis: bot scoring, client-side R9K, audit log and a live-viewer estimate. Chrome/Edge/Opera, Firefox and Safari for macOS, RU/EN.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.js",
    "build:all": "node build.js --all",
    "build:firefox": "node build.js --firefox-only",
    "build:safari": "node build.js --safari-only",
    "package:safari": "node tools/package-safari.mjs",
    "dev": "node build.js --watch",
    "package": "node build.js --package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build:all && npm run test:e2e",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "verify": "npm run test && npm run build:all && npm run lint:firefox && npm run test:e2e"
  },
  "keywords": [
    "twitch",
    "chat",
    "bot-detection",
    "r9k",
    "manifest-v3",
    "webextension",
    "chrome-extension",
    "firefox-addon"
  ],
  "author": "Chat X-Ray contributors",
  "dependencies": {
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "vitest": "^3.2.7",
    "web-ext": "^10.8.0"
  }
}
